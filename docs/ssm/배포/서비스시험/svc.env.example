# 서비스 시험 설정 — 이 파일을 svc.env 로 복사해 값을 넣는다. svc.env 는 git 에 올라가지 않는다(.gitignore).
# 🚨 비밀번호가 들어가는 파일이다 — 메신저 · 저장소에 올리지 않는다.

# 시험할 주소 (비우면 https://copylane.site)
SVC_BASE=https://copylane.site

# 일반 회원 시험 계정 — 비우면 실행할 때 묻는다
CL_TEST_EMAIL=
CL_TEST_PASSWORD=

# 관리자 계정 — --admin-open (관리자 허용 IP 에서 실행) 때만 쓴다
CL_ADMIN_EMAIL=
CL_ADMIN_PASSWORD=
