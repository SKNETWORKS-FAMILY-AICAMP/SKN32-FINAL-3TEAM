# env & secrets
# 🚨 `.env` 한 줄로는 모자란다. 편집기·백업·OS 가 곁가지를 만든다
#    (.env~ · .env.bak · .env.save · .env.local). 그 파일들에도 키가 그대로 들어 있는데
#    이름이 달라서 위 한 줄에 안 걸린다 — 유출은 항상 「덮은 줄 알았던 이름」으로 난다.
.env
.env.*
!.env.example
*.key

# python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# data — 등급 디렉터리 내용은 커밋하지 않는다 (D-19). 구조와 원장만 남긴다.
#  🚨 `!data/**/` 가 필요하다 — 디렉터리 자체를 무시하면 git 이 그 아래로 내려가지
#     않아 중첩된 .gitkeep 을 되살릴 수 없다.
data/**
!data/**/
!data/**/.gitkeep
!data/manifest.jsonl

# models & experiments
models/
mlruns/
*.gguf
*.onnx

# build (D-53: 제출본은 빌드 결과물)
dist/
# 🚨 생성물 전용 디렉터리. 손으로 쓴 입력은 여기 두지 않는다 —
#    scripts/registry_head.yaml · registry_tail.yaml 이 그 입력이고 커밋 대상이다.
build/

# misc
.DS_Store
Thumbs.db
.idea/
