# ============================================================
#  CopyLane 환경 변수 — 복사해서 .env 로 씁니다
# ------------------------------------------------------------
#  setup.bat 이 이 파일을 .env 로 자동 복사합니다.
#
#  🚨🚨 값은 이 파일에 채우지 마십시오. 이 파일은 **커밋됩니다** (.env 만 gitignore 입니다).
#       두 파일이 나란히 있고 내용이 거의 같아서, 잘못 여는 것은 드문 실수가 아닙니다.
#       게이트 30 이 이 파일의 값을 검사해 낙방시킵니다 (D-111).
#
#  키 넣는 법 — 화면에 뜨지 않게 받아서 .env 에 넣습니다
#       uv run python launcher.py setkey FOODSAFETY_KEY
#  들어갔는지 확인 — 값이 아니라 지문으로 봅니다 (붙여 넣어도 안전합니다)
#       uv run python launcher.py keys
#  🚨 셸에 직접 치지 마십시오 — PowerShell 기록 파일에 그대로 남습니다.
#
#  🚨 .env 는 절대 커밋하지 않습니다 — .gitignore + pytest 게이트가 검사합니다.
#  🚨 키 이름은 이 파일이 단일 출처입니다. 스크립트마다 다른 이름을 쓰지 않습니다.
#     읽는 곳은 collect/env.py 한 곳뿐입니다.
#
#  「필요 시점」 읽는 법
#     지금   비어 있으면 당장 막힙니다
#     곧     해당 주차에 막힙니다. 발급에 시간이 걸리면 미리 신청하세요
#     기본값 그대로 두면 됩니다
# ============================================================


# ─────────────────────────────────────────────────────────────
#  1. 데이터 수집          담당 T1 · 필요 시점 1W~2W
# ─────────────────────────────────────────────────────────────
#  없으면 수집기가 첫 줄에서 멈춥니다. 오류 메시지가 발급처를 알려줍니다.

# 🚨 지금 · 법제처 OPEN API (S0-01 · 승인 완료 — 값만 넣으면 됩니다)
#    쓰는 곳  collect/law_api.py · scripts/law_api_smoke.py
#    발급     open.law.go.kr > 마이페이지 > OPEN API 신청현황
#    값 형태  이메일의 @ 앞부분만 (전체 주소가 아닙니다)
#    없으면   법령 6종·고시 2종(S1-01·S1-02)을 못 받습니다 — 사전 구축이 통째로 멈춥니다
LAW_OC_KEY=

# 곧 · 공공데이터포털 (S0-05) — 식약처 API 4종
#    쓰는 곳  건기식 기능성 원료인정 현황(S1-04) · 개별인정형 정보(S1-05) · 행정처분결과(S2-03)
#    발급     data.go.kr 활용신청 — 즉시~1일
DATA_GO_KR_KEY=

# 🚨 위 키가 아니다 — 식품안전나라에서 따로 발급받는다.
#    15058359(건기식 기능성 원료)는 data.go.kr 의 **API 유형이 LINK** 라
#    실제 호출이 openapi.foodsafetykorea.go.kr 로 가고 키도 그쪽 것이다.
#    data.go.kr 활용신청 버튼이 그 사이트로 보낸다. 필요 시점 1W
FOODSAFETY_KEY=

# 곧 · KOSIS 국가통계 (S0-06) — 6층 세그먼트
#    발급     kosis.kr/serviceInfo/openAPIGuide.do — 자동 발급 (즉시)
KOSIS_KEY=

# 곧 · AI Hub aihubshell — 승인된 데이터셋 (5층 코퍼스)
#    🚨 몇 종인지는 여기 적지 않습니다 — 승인 현황은 레지스트리의 approved_at 이 원본입니다.
#       숫자를 여기 적으면 두 곳이 갈립니다 — 실제로 「5종」이라 적은 그날
#       승인 목록은 **6건**이었습니다. 늘어난 게 아니라 우리가 하나를 몰랐던 겁니다.
#    발급     aihub.or.kr > 오픈 API(aihubshell) > API key 발급 → 메일로 옵니다
#    🚨 키와 승인은 **다른 것**입니다. 데이터셋마다 승인이 따로 나야 받아집니다 (GATED).
#    🚨 aihubshell 은 bash 도구라 Windows PowerShell 에서는 그대로 안 돕니다.
#    🚨 하드 제약 ④ — AI Hub 원본은 클라우드 컨테이너에 올리지 않습니다. 받는 것은 로컬입니다.
AIHUB_KEY=


# ─────────────────────────────────────────────────────────────
#  1-1. 데이터 역할 · 공유 저장소     🆕 2026-09-19 (검토 2026-09-19 §11 · D-247)
# ─────────────────────────────────────────────────────────────
#  이 기기가 파생물(data/derived)을 **만드는 곳**인가 **받는 곳**인가.
#    replica    받는 쪽 — 클론 A · 팀원 · 서버.  런처가 부족한 파생물을 공유 저장소에서 받는다
#    canonical  만드는 쪽 — 🔴 **클론 B 한 곳만** 손으로 바꾼다 (D-226). 받기를 끄고 올리기를 연다
#  🚨 모르는 값이면 멈춥니다 (D-220) — 오타가 조용히 다른 역할이 되면 안 됩니다.
#  🚨 비워 두면 「역할 없음」— CI 와 같습니다. 있는 것만 대조하고 아무것도 받지 않습니다.
# 기본값 · 새 기기는 그대로 두면 됩니다
DATA_ROLE=replica

#  공유 저장소 — 파생물 바이트를 sha256 이름으로 두는 **폴더** (팀 비공개 Google Drive · D-247 · D-249).
#  🚨 기기마다 경로가 다릅니다 — 예: J:\내 드라이브\CopyLane_store
#  ★ 손으로 적지 않습니다 — `uv run python launcher.py data-setup` 이 드라이브에서 찾아 두 줄을 적습니다
#  🚨 **제3자 계정**입니다 (D-78 ③). 원문캐시·재배포 제약 소스는 코드가 올리기 전에 거부합니다.
DATA_STORE=

# ─────────────────────────────────────────────────────────────
#  2. 데이터베이스          담당 T1 · 필요 시점 1W~
# ─────────────────────────────────────────────────────────────
#  기본값은 docker-compose.yml 과 짝입니다. setup.bat 이 컨테이너를 띄웁니다.
#  🚨 127.0.0.1 로만 바인딩합니다 — 0.0.0.0 노출 금지 (배포계획 P3-14)
#  🚨 엔진은 PostgreSQL 입니다. MySQL 이 아닙니다 (D-95 — pgvector 가 PG 확장)
#  배포 시에는 이 한 줄만 RDS 주소로 바꿉니다. 코드 변경은 없습니다 (D-79 ⑦)

# 기본값 · 그대로 두면 됩니다
#  🔄 2026-09-12 밤 (D-209) — **세 형태를 다 받습니다.** 소비자가 둘이기 때문입니다:
#     alembic(SQLAlchemy)은 `+psycopg` 를 **요구**하고, psycopg 직결은 그것을 **못 읽습니다.**
#     `app/settings.py` 가 한 값을 받아 `dsn()`(뗌)·`sqlalchemy_url()`(붙임) 둘로 냅니다.
#     ⛔ 09-12 밤 한때 검증기가 아래 값을 **거부**했습니다 — 이 줄을 그대로 복사한 사람이
#        전부 밟는 자리였습니다. 게이트가 이제 이 줄과 코드를 대조합니다.
DATABASE_URL=postgresql+psycopg://copylane:copylane@localhost:5432/copylane


# 🆕 2026-09-12 밤 (D-213) · 에디션 — **관리자 화면이 붙는지를 정한다**
#    local (기본 · 개발) / demo (발표) / onprem / cloud
#    🔴 `cloud` 에서는 관리자 화면과 로그인이 **아예 안 붙는다** — 라우트가 없으면 404 다.
#       배포 그림(§1)에 제품 관리자 화면의 자리가 없었고, 공개 쪽에 두면 등급 판정 근거와
#       2인 확인 서명(사람 이름)이 인터넷에 선다. 읽기 전용이어도 같다 (D-76 · P2-10).
#    ⛔ 기본값이 `local` 인 이유 — 위험한 쪽(cloud)이 **기본값이 아니라 명시**여야 한다.
#    🚨 오타는 조용히 안 넘어간다 — 아는 값이 아니면 뜨지 않는다 (D-220).
COPYLANE_EDITION=local

# 🆕 세션 쿠키 서명 키 (D-213). **비워 두면 프로세스마다 새로 만든다** — 재시작하면 로그아웃된다.
#    ⛔ 기본 키를 코드에 박지 않는다. 박는 순간 그 키가 **모두의 키**가 된다.
#    🚨 배포에서만 채운다 — 값은 서버에서 직접 만든다:
#       python -c "import secrets;print(secrets.token_urlsafe(32))"
COPYLANE_SESSION_SECRET=


# ─────────────────────────────────────────────────────────────
#  3. 학습 · 실험           담당 T2·T3 · 필요 시점 3W~
# ─────────────────────────────────────────────────────────────
#  🚨 LangSmith · W&B 는 쓰지 않습니다 (D-43) — 문구·트레이스가 밖으로 나갑니다.
#  실험 기록은 MLflow 로컬 하나로 통일합니다 (D-94 — 결과가 한 표에 모여야 비교됩니다)

# 기본값 · 로컬 파일 저장소
MLFLOW_TRACKING_URI=file:./mlruns

# 🔴 **추적 끄기 — 지우지 마십시오** (2026-09-10 · D-43)
#    ⛔ `langgraph` → `langchain-core` → `langsmith` 가 **전이 의존**이라 패키지 자체는
#       뺄 수 없습니다. 켜지면 광고 문구 원문이 외부로 나갑니다.
#    🚨 `true` 로 바꾸면 `pytest -m gate` 가 실패하고 `build_graph()` 가 멈춥니다.
#       조용히 끄지 않습니다 — 켠 사람이 자기가 켠 것이 무시된 줄 모르면 더 나쁩니다.
#    ★ 실측 — `LANGCHAIN_TRACING_V2` 가 `LANGSMITH_TRACING` 을 이깁니다. 둘 다 적습니다.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# 곧 · RunPod (3W~ 학습) — 🚨 계정이 팀당 1개입니다.
#    동시 실행 충돌·크레딧 소모를 막을 슬롯 규칙을 먼저 정합니다 (D-94)
#    발급 담당  소성민
# RUNPOD_API_KEY=


# ─────────────────────────────────────────────────────────────
#  4. 평가 · 비교 (런타임 아님)   담당 T3 · 필요 시점 4W~
# ─────────────────────────────────────────────────────────────
#  🚨🚨 이 키는 「평가·비교 전용」입니다 (D-78 ②).
#     판정·생성 런타임 경로에 들어가면 안 됩니다 — doctor 검사 16번이
#     「판정 경로의 외부 네트워크 요청 = 0」을 검사해 즉시 실패시킵니다 (D-73 · D-77 L4).
#     학습 데이터 생성에도 쓰지 않습니다.
#    쓰는 곳  경쟁 비교 실측 · 제3 판정기 (배치)

# OPENAI_API_KEY=


# ─────────────────────────────────────────────────────────────
#  5. 배포                  담당 T5 · 필요 시점 9W
# ─────────────────────────────────────────────────────────────
#  🚨 AWS 는 제3자 제공 계정입니다 (D-78 ③).
#     g2_norepub/ · quarantine/ 를 올리지 않습니다 — doctor 검사 15번이 봅니다.
#  자격증명은 .env 가 아니라 서버의 IAM 역할·시크릿으로 다룹니다.
#  여기 적지 마십시오 — 이 파일 형태가 로컬 개발용이라 유출 경로가 다릅니다.
