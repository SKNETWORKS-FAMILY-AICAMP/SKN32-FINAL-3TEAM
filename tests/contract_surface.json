  "models": {
    "AdSection": {
      "kind": "req builtins.str",
      "order": "req builtins.int",
      "placeholder": "opt str | None",
      "text": "opt str | None"
    },
    "AdaptedCopy": {
      "channel": "req app.contracts.Channel",
      "disclosure": "req builtins.str",
      "disclosure_placement": "req builtins.str",
      "recheck": "req app.contracts.SentenceJudgment",
      "rewrite": "req app.contracts.RewriteSet"
    },
    "Branch": {
      "criteria": "req builtins.str",
      "evidence": "opt list[app.contracts.EvidenceArticle]",
      "outcome": "req app.contracts.Outcome",
      "premise": "req app.contracts.Premise",
      "sentences": "opt list[app.contracts.SentenceJudgment]",
      "verified": "opt builtins.bool"
    },
    "Candidate": {
      "appeal_retention": "req builtins.float",
      "label": "req builtins.str",
      "pareto": "opt builtins.bool",
      "residual_risk": "req app.contracts.Risk",
      "rewrite": "req app.contracts.RewriteSet"
    },
    "Certificate": {
      "explanation": "req builtins.str",
      "guidance": "opt str | None",
      "reason": "req app.contracts.Infeasibility"
    },
    "ComposeRequest": {
      "ad_format": "req app.contracts.AdFormat",
      "product": "opt app.contracts.ProductContext",
      "prompt": "opt str | None",
      "source_copy": "opt app.contracts.AdaptedCopy | None"
    },
    "ComposeResponse": {
      "ad_format": "req app.contracts.AdFormat",
      "disclosure_section_order": "opt int | None",
      "screening": "opt list[app.contracts.SentenceJudgment]",
      "sections": "opt list[app.contracts.AdSection]"
    },
    "EvidenceArticle": {
      "article": "req builtins.str",
      "chunk_id": "opt str | None",
      "item": "opt builtins.str",
      "law_id": "req builtins.str",
      "quote": "opt str | None"
    },
    "GenerateRequest": {
      "keywords": "opt list[app.contracts.KeywordScreen]",
      "product": "opt app.contracts.ProductContext",
      "profile": "opt app.contracts.MediaProfile | None",
      "segment": "req app.contracts.Segment"
    },
    "GenerateResponse": {
      "adapted": "opt list[app.contracts.AdaptedCopy]",
      "candidates": "opt list[app.contracts.Candidate]",
      "keywords": "opt list[app.contracts.KeywordScreen]",
      "outcome": "req app.contracts.GenerateOutcome"
    },
    "JudgeRequest": {
      "product": "opt app.contracts.ProductContext",
      "text": "req builtins.str"
    },
    "JudgeResponse": {
      "attempt": "opt builtins.int",
      "branches": "opt list[app.contracts.Branch]",
      "candidates": "opt list[app.contracts.Candidate]",
      "category": "opt app.contracts.Category | None",
      "certificate": "opt app.contracts.Certificate | None",
      "judged_by": "opt builtins.str",
      "law_version": "opt builtins.str",
      "not_reviewed": "opt list[str]",
      "outcome": "req app.contracts.Outcome",
      "sentences": "opt list[app.contracts.SentenceJudgment]",
      "timings": "opt list[app.contracts.Timing]"
    },
    "KeywordScreen": {
      "allowed": "req builtins.bool",
      "evidence": "opt list[app.contracts.EvidenceArticle]",
      "reason": "opt str | None",
      "term": "req builtins.str"
    },
    "MediaProfile": {
      "channel": "req app.contracts.Channel",
      "disclosure_placement": "req builtins.str",
      "max_chars": "opt int | None",
      "max_sentences": "opt int | None",
      "tone": "opt str | None"
    },
    "ProductContext": {
      "category": "opt app.contracts.Category | None",
      "has_recognized_function": "opt builtins.bool",
      "recognition_no": "opt str | None"
    },
    "RewriteSet": {
      "body": "req builtins.str",
      "mandatory_note": "opt str | None",
      "placement": "opt str | None"
    },
    "RiskAssessment": {
      "encoder": "opt app.contracts.Risk | None",
      "evidence_span": "opt app.contracts.Span | None",
      "final": "opt app.contracts.Risk | None",
      "floor": "opt app.contracts.Risk | None"
    },
    "Segment": {
      "label": "req builtins.str",
      "member_count": "req builtins.int",
      "segment_id": "req builtins.str",
      "top_terms": "opt list[str]",
      "vulnerable_flag": "opt builtins.bool"
    },
    "SentenceJudgment": {
      "evidence": "opt list[app.contracts.EvidenceArticle]",
      "evidence_mismatch": "opt builtins.bool",
      "hold_reason": "opt app.contracts.HoldReason | None",
      "infeasibility": "opt app.contracts.Infeasibility | None",
      "not_claim": "opt builtins.bool",
      "risk": "opt app.contracts.RiskAssessment",
      "sent_id": "req builtins.str",
      "spans": "opt list[app.contracts.Span]",
      "substantiation": "opt app.contracts.SubstBranch | None",
      "text": "req builtins.str",
      "verdict": "req app.contracts.Verdict",
      "violations": "opt list[app.contracts.Violation]"
    },
    "Span": {
      "end": "req builtins.int",
      "label": "opt str | None",
      "start": "req builtins.int"
    },
    "SubstBranch": {
      "accepted_evidence": "req list[str]",
      "criteria": "req builtins.str",
      "substantiated_max": "req app.contracts.Risk"
    },
    "Timing": {
      "ms": "req builtins.float",
      "node": "req builtins.str"
    }
  },
